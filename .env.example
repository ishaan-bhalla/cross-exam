# AssemblyAI
ASSEMBLYAI_API_KEY=
# LLM Gateway
LLM_GATEWAY_URL=https://llm-gateway.assemblyai.com/v1/chat/completions
LLM_MODEL=qwen3.5-4b-32k-fast
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=4
LLM_RETRY_BACKOFF_SECONDS=2
# Streaming speech-to-text (spoken questions). The browser connects directly with a
# temporary token created by the server, so the API key never reaches it.
STT_WS_URL=wss://streaming.assemblyai.com/v3/ws
STT_TOKEN_URL=https://streaming.assemblyai.com/v3/token
STT_SPEECH_MODEL=universal-3-6-pro
STT_SAMPLE_RATE=16000
# Microphone audio is sent in frames of this length (the API accepts 50-1000 ms)
STT_CHUNK_MS=100
# Token lifetime (1-600 s: the session must start within it) and maximum session length (60-10800 s)
STT_TOKEN_EXPIRES_SECONDS=60
STT_MAX_SESSION_SECONDS=600
# The API accepts at most 100 key terms
STT_MAX_KEYTERMS=100
# After an end of turn, wait this long for more speech before submitting; every final turn
# since the mic started is joined into one question
STT_SUBMIT_GRACE_MS=1200
# End-of-turn detection, passed to the STT API when set (empty = the API's default).
# min/max turn silence in ms; the confidence threshold (0-1) applies to the
# universal-streaming-* models only
STT_MIN_TURN_SILENCE_MS=
STT_MAX_TURN_SILENCE_MS=
STT_END_OF_TURN_CONFIDENCE=
# Streaming TTS
TTS_WS_URL=wss://streaming-tts.assemblyai.com/v1/ws
TTS_DEFAULT_VOICE=charles
TTS_TIMEOUT_SECONDS=10
TTS_SAMPLE_RATE=24000
# Retries when the account's concurrent TTS session limit is hit (error 3009)
TTS_SESSION_RETRIES=3
TTS_SESSION_RETRY_BACKOFF_SECONDS=1
# Leading-silence trim: samples quieter than this (PCM16 amplitude) count as silence;
# keep this much audio before the first loud sample so the onset is not clipped
TTS_SILENCE_THRESHOLD=500
TTS_TRIM_PREROLL_MS=40
# Silence kept after the last loud sample of a cached phrase or a live answer
TTS_TRIM_TAIL_MS=100
# Quotes are sent as one flush per chunk: sentences, with sentences longer than this many
# words split at clause punctuation; silence between chunks is capped at TTS_CHUNK_GAP_MS
TTS_CHUNK_MAX_WORDS=12
TTS_CHUNK_GAP_MS=150
# Pause inserted between a lead-in and the quote
TTS_LEAD_IN_GAP_MS=250
# KeepAlive interval for the per-examination TTS session while idle
TTS_KEEPALIVE_SECONDS=10
# After all audio for an answer has arrived, how long to wait for missing word timings
TTS_WORDS_WAIT_SECONDS=2
# After a lead-in, the browser holds the quote audio until its word timings arrive, up to this long
QUOTE_TIMINGS_MAX_WAIT_MS=800
# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=2.0
# bm25 | dense | hybrid
RETRIEVER=dense
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
RRF_K=60
# Hybrid fusion weight on dense (0..1): w/(k+rank_dense) + (1-w)/(k+rank_bm25)
DENSE_WEIGHT=0.5
# Refusal gate for dense/hybrid (top cosine similarity); 0 disables it.
DENSE_MIN_SCORE=0.56
HYDE_ENABLED=false
# LLM yes/no check that a retrieved paragraph answers the question, before answering
RELEVANCE_CHECK_ENABLED=false
# Inquiry document IDs; questions citing one are routed to the paragraphs that mention it. Empty disables.
DOC_ID_PATTERN='\b[A-Z]{3,4}\d{8}\b'
# Spoken questions: a rebuilt document ID is corrected to a cited one only if exactly one is
# within this many edits
DOC_ID_SNAP_MAX_DISTANCE=1
# Paths (relative to project root)
DATA_DIR=data
PROMPTS_DIR=prompts
WITNESS_ANSWER_PROMPT=witness_answer.txt
LEAD_INS_FILE=lead_ins.json
HYDE_PROMPT=hyde.txt
RELEVANCE_CHECK_PROMPT=relevance_check.txt
OUTPUTS_DIR=outputs
PROCESSED_DIR=data/processed
EVAL_DIR=eval
EMBEDDING_CACHE_DIR=data/models
# Pre-synthesised fixed phrases (lead-ins, refusals); empty keeps them in memory only
PHRASE_CACHE_DIR=data/tts_cache
WITNESSES_FILE=witnesses/witnesses.json
WEB_DIR=src/crossexam/web
# Web app
API_HOST=127.0.0.1
API_PORT=8000
# Audio buffered in the browser before playback starts
UI_AUDIO_BUFFER_MS=200
